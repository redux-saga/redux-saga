{
  "name": "@redux-saga/unplugin",
  "version": "1.0.0",
  "description": "Attaches source locations to sagas and effects so redux-saga can print saga stacks. One plugin for Vite, Rollup, Rolldown, webpack, Rspack and esbuild.",
  "license": "MIT",
  "repository": "https://github.com/redux-saga/redux-saga/tree/main/packages/unplugin",
  "author": "Yassine ELOUAFI <yelouafi@gmail.com>",
  "bugs": {
    "url": "https://github.com/redux-saga/redux-saga/issues"
  },
  "homepage": "https://redux-saga.js.org/",
  "keywords": [
    "redux-saga",
    "unplugin",
    "vite-plugin",
    "rollup-plugin",
    "webpack-plugin",
    "rspack-plugin",
    "esbuild-plugin"
  ],
  "main": "dist/redux-saga-unplugin.cjs.js",
  "module": "dist/redux-saga-unplugin.esm.js",
  "exports": {
    "./vite": {
      "types": {
        "import": "./vite/dist/redux-saga-unplugin-vite.cjs.mjs",
        "default": "./vite/dist/redux-saga-unplugin-vite.cjs.js"
      },
      "module": "./vite/dist/redux-saga-unplugin-vite.esm.js",
      "import": "./vite/dist/redux-saga-unplugin-vite.cjs.mjs",
      "default": "./vite/dist/redux-saga-unplugin-vite.cjs.js"
    },
    ".": {
      "types": {
        "import": "./dist/redux-saga-unplugin.cjs.mjs",
        "default": "./dist/redux-saga-unplugin.cjs.js"
      },
      "module": "./dist/redux-saga-unplugin.esm.js",
      "import": "./dist/redux-saga-unplugin.cjs.mjs",
      "default": "./dist/redux-saga-unplugin.cjs.js"
    },
    "./rollup": {
      "types": {
        "import": "./rollup/dist/redux-saga-unplugin-rollup.cjs.mjs",
        "default": "./rollup/dist/redux-saga-unplugin-rollup.cjs.js"
      },
      "module": "./rollup/dist/redux-saga-unplugin-rollup.esm.js",
      "import": "./rollup/dist/redux-saga-unplugin-rollup.cjs.mjs",
      "default": "./rollup/dist/redux-saga-unplugin-rollup.cjs.js"
    },
    "./rspack": {
      "types": {
        "import": "./rspack/dist/redux-saga-unplugin-rspack.cjs.mjs",
        "default": "./rspack/dist/redux-saga-unplugin-rspack.cjs.js"
      },
      "module": "./rspack/dist/redux-saga-unplugin-rspack.esm.js",
      "import": "./rspack/dist/redux-saga-unplugin-rspack.cjs.mjs",
      "default": "./rspack/dist/redux-saga-unplugin-rspack.cjs.js"
    },
    "./esbuild": {
      "types": {
        "import": "./esbuild/dist/redux-saga-unplugin-esbuild.cjs.mjs",
        "default": "./esbuild/dist/redux-saga-unplugin-esbuild.cjs.js"
      },
      "module": "./esbuild/dist/redux-saga-unplugin-esbuild.esm.js",
      "import": "./esbuild/dist/redux-saga-unplugin-esbuild.cjs.mjs",
      "default": "./esbuild/dist/redux-saga-unplugin-esbuild.cjs.js"
    },
    "./webpack": {
      "types": {
        "import": "./webpack/dist/redux-saga-unplugin-webpack.cjs.mjs",
        "default": "./webpack/dist/redux-saga-unplugin-webpack.cjs.js"
      },
      "module": "./webpack/dist/redux-saga-unplugin-webpack.esm.js",
      "import": "./webpack/dist/redux-saga-unplugin-webpack.cjs.mjs",
      "default": "./webpack/dist/redux-saga-unplugin-webpack.cjs.js"
    },
    "./rolldown": {
      "types": {
        "import": "./rolldown/dist/redux-saga-unplugin-rolldown.cjs.mjs",
        "default": "./rolldown/dist/redux-saga-unplugin-rolldown.cjs.js"
      },
      "module": "./rolldown/dist/redux-saga-unplugin-rolldown.esm.js",
      "import": "./rolldown/dist/redux-saga-unplugin-rolldown.cjs.mjs",
      "default": "./rolldown/dist/redux-saga-unplugin-rolldown.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/redux-saga-unplugin.cjs.d.ts",
  "files": [
    "dist",
    "vite",
    "rollup",
    "rolldown",
    "webpack",
    "rspack",
    "esbuild"
  ],
  "preconstruct": {
    "entrypoints": [
      "index.js",
      "vite.js",
      "rollup.js",
      "rolldown.js",
      "webpack.js",
      "rspack.js",
      "esbuild.js"
    ]
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test:types": "tsc -p types/tsconfig.json --noEmit && tsc -p types/tsconfig.adapters.json --noEmit"
  },
  "dependencies": {
    "magic-string": "^0.30.5",
    "oxc-parser": "^0.156.0",
    "unplugin": "^2.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@rspack/core": "^1.7.12",
    "@types/node": "^24.19.2",
    "babel-plugin-redux-saga": "workspace:*",
    "esbuild": "^0.28.2",
    "rolldown": "^1.3.0",
    "rollup": "^4.67.5",
    "source-map": "^0.6.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "webpack": "^5.112.2"
  }
}
