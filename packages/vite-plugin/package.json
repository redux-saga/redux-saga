{
  "name": "@redux-saga/vite-plugin",
  "version": "0.0.0",
  "description": "Attaches source locations to sagas and effects so redux-saga can print saga stacks. Works with Vite, Rollup, Rolldown, webpack, Rspack and esbuild.",
  "license": "MIT",
  "repository": "https://github.com/redux-saga/redux-saga/tree/main/packages/vite-plugin",
  "keywords": [
    "vite-plugin",
    "unplugin",
    "redux-saga"
  ],
  "main": "dist/redux-saga-vite-plugin.cjs.js",
  "module": "dist/redux-saga-vite-plugin.esm.js",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/redux-saga-vite-plugin.cjs.mjs",
        "default": "./dist/redux-saga-vite-plugin.cjs.js"
      },
      "module": "./dist/redux-saga-vite-plugin.esm.js",
      "import": "./dist/redux-saga-vite-plugin.cjs.mjs",
      "default": "./dist/redux-saga-vite-plugin.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/redux-saga-vite-plugin.cjs.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {},
  "dependencies": {
    "magic-string": "^0.30.0",
    "oxc-parser": "^0.156.0",
    "unplugin": "^2.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "babel-plugin-redux-saga": "workspace:*",
    "source-map": "^0.6.1"
  },
  "peerDependencies": {
    "redux-saga": "^1.0.0"
  }
}
